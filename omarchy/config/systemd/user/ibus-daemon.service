[Unit]
Description=IBus input method daemon (Vikey)
# Same session wiring as Omarchy's omarchy-fcitx5.service: start once uwsm has
# imported WAYLAND_DISPLAY, stop with the compositor, and stay inert over SSH.
After=graphical-session.target
PartOf=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionPathExists=/usr/bin/ibus-daemon

[Service]
Type=dbus
BusName=org.freedesktop.IBus
# The panel only shows a StatusNotifier icon, which the Omarchy bar can
# display, when it thinks it runs on KDE.
ExecStart=/usr/bin/ibus-daemon --replace --xim "--panel=/usr/bin/env XDG_CURRENT_DESKTOP=KDE /usr/lib/ibus/ibus-ui-gtk3"
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
